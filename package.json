{
  "name": "devsecops-exam-starter",
  "version": "1.0.0",
  "description": "Baseline API for LSCS DevSecOps Engineering Exam",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "verify": "node scripts/verify.js",
    "verify:fast": "node scripts/verify.js --fast",
    "docker:build": "docker build -t macky-merch-api:local .",
    "docker:run": "docker run --rm --init -p 3000:3000 macky-merch-api:local"
  },
  "author": "La Salle Computer Society",
  "license": "ISC",
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
