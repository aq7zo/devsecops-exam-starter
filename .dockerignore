# Rebuilt inside the image by `npm ci`. Copying a host-built tree in would also
# import whatever platform-specific native binaries the host compiled.
node_modules/

# History and CI config are not runtime inputs. .git in particular can carry
# credentials in its config/logs and would land in an image layer forever.
.git/
.github/
.gitignore
.gitleaks.toml

# Secrets: never bake these into a layer -- inject at run time.
.env
.env.*
!.env.example

# Deliberately vulnerable fixtures for the scanner demo. These exist to be
# caught by CI, not to be shipped.
security-demo/

# Build/test artefacts and local noise.
coverage/
npm-debug.log*
*.log
Dockerfile
.dockerignore
docker-compose*.yml
docs/
*.md
!README.md
.vscode/
.idea/
.DS_Store
Thumbs.db
