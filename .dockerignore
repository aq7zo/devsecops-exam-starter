# Rebuilt by `npm ci` inside the image; copying the host tree in would import
# native binaries built for the wrong platform.
node_modules/

# Not runtime inputs. .git can carry credentials in its config and logs, and
# would land in an image layer permanently.
.git/
.github/
.gitignore
.gitleaks.toml

# Injected at run time; baking them into a layer is permanent.
.env
.env.*
!.env.example

# Deliberately vulnerable scanner fixtures -- meant to be caught by CI, not
# shipped.
security-demo/

coverage/
npm-debug.log*
*.log
Dockerfile
Makefile
.dockerignore
docker-compose*.yml
docs/
*.md
!README.md
.vscode/
.idea/
.DS_Store
Thumbs.db
